# ==============================================================================
#  Neural Node & Code - .gitignore
#  Deoxyribonucleic IT | NeuralOSNODE
# ------------------------------------------------------------------------------
#  Purpose: keep secrets, keys, personal data, and build junk OUT of Git.
#  Rule of thumb: if a file could identify you or unlock something, it belongs
#  here. A .gitignore only stops NEW files from being tracked. It does not
#  remove files that were already committed.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. GPG / OpenPGP (YubiKey signing keys)
# ------------------------------------------------------------------------------
# Your real private keys live on the YubiKey and in %APPDATA%\gnupg, never in
# this repo. These patterns catch accidental exports, backups, or copies.
.gnupg/
private-keys-v1.d/
openpgp-revocs.d/
*.gpg
*.pgp
*.asc
*.rev
secring.*
pubring.*
trustdb.gpg
gpg.conf
gpg-agent.conf
scdaemon.conf
dirmngr.conf
sshcontrol


# ------------------------------------------------------------------------------
# 2. YubiKey exports and backups
# ------------------------------------------------------------------------------
# PIV certificates, management key notes, and backup bundles.
yubikey-backup*
yubikey_backup*
ykman-*
*.yubikey
*.p12
*.pfx


# ------------------------------------------------------------------------------
# 3. SSH keys and configuration
# ------------------------------------------------------------------------------
# Covers classic keys, hardware-backed (FIDO / -sk) keys, and PuTTY keys.
.ssh/
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*_sk
*_sk.pub
*.ppk
known_hosts
known_hosts.old
authorized_keys


# ------------------------------------------------------------------------------
# 4. Certificates and general key material
# ------------------------------------------------------------------------------
*.pem
*.key
*.crt
*.csr
*.der
*.jks
*.keystore
*.kdbx
*.ovpn


# ------------------------------------------------------------------------------
# 5. Environment files and secrets
# ------------------------------------------------------------------------------
# Real settings go in .env (ignored). The template .env.example IS committed
# so anyone who clones the repo knows which settings to create.
.env
.env.*
!.env.example
*.secret
secrets/
credentials*.json
*.token


# ------------------------------------------------------------------------------
# 6. Python (backend)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ------------------------------------------------------------------------------
# 7. Database (SQLite runtime data)
# ------------------------------------------------------------------------------
# The database is rebuilt from the seed files, so it never needs committing.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/data/


# ------------------------------------------------------------------------------
# 8. Node.js / Vite (frontend)
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------------------------
# 9. Logs and temporary files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~


# ------------------------------------------------------------------------------
# 10. Editors and IDEs
# ------------------------------------------------------------------------------
# VS Code workspace settings can contain personal file paths, so they stay
# local.
.vscode/
.idea/
*.code-workspace


# ------------------------------------------------------------------------------
# 11. Operating system files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS (for anyone who clones on a Mac)
.DS_Store
._*


# ------------------------------------------------------------------------------
# 12. Privacy: recordings and archives
# ------------------------------------------------------------------------------
# Raw demo recordings may show personal details. Edit and upload them
# elsewhere, never commit them.
recordings/
*.mp4
*.mov
*.mkv
*.flv
*.zip
*.7z
*.rar