# =============================================================================
#  Neural Node & Code - .gitignore
#  Security-first ignore rules for a TypeScript + Babylon.js + Vite project.
#
#  IMPORTANT: .gitignore only prevents NEW files from being tracked.
#  If a sensitive file was already committed, run:
#      git rm --cached <file>
#  and rotate/revoke that secret immediately. Ignoring it is not enough.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Environment variables and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
.envrc
config.local.*
*.local.json
*.local.ts
*.local.js


# -----------------------------------------------------------------------------
#  2. Secrets, tokens, and credentials
# -----------------------------------------------------------------------------
secrets/
.secrets/
secret.*
secrets.*
credentials.*
*.credentials
*.secret
*.token
token.txt
api-keys.*
apikeys.*
auth.json
.netrc
.git-credentials
.npmrc
.yarnrc
.yarnrc.yml


# -----------------------------------------------------------------------------
#  3. GPG / PGP keys and keyrings
#  Never commit private keys, keyrings, trust databases, or revocation
#  certificates. If you ever want to publish your PUBLIC key in this repo,
#  add a specific exception below, for example:
#      !keys/neural-node-public.asc
# -----------------------------------------------------------------------------
.gnupg/
*.gpg
*.pgp
*.asc
*.sig
*.kbx
*.rev
secring.*
pubring.*
trustdb.gpg
random_seed
sshcontrol
gpg-agent.conf
private-keys-v1.d/
openpgp-revocs.d/
*-secret-key*
*-secret-subkeys*
*_secret_key*
*private-key*
*privatekey*
revocation-cert*


# -----------------------------------------------------------------------------
#  4. YubiKey and hardware security key material
#  YubiKey tools (ykman, YubiKey Manager, Yubico Authenticator) do not use one
#  standard file extension, so these rules cover common export and backup
#  names. Keep PINs, PUKs, management keys, OATH secrets, and recovery codes
#  in a password manager, never in this repository.
# -----------------------------------------------------------------------------
yubikey-*
*-yubikey-*
*_yubikey_*
ykman-*
*.ykpers
piv-management-key*
management-key*
*-pin.txt
*-puk.txt
pin-backup*
puk-backup*
oath-secrets*
otp-secrets*
totp-secrets*
fido2-*
recovery-codes*
*-recovery-codes*
backup-codes*
*-backup-codes*


# -----------------------------------------------------------------------------
#  5. SSH keys, certificates, and keystores
# -----------------------------------------------------------------------------
.ssh/
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
known_hosts
authorized_keys
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.p7b
*.p12
*.pfx
*.jks
*.keystore
*.truststore


# -----------------------------------------------------------------------------
#  6. Cloud provider and deployment credentials
# -----------------------------------------------------------------------------
.aws/
.azure/
.gcloud/
.config/gcloud/
*service-account*.json
.docker/config.json
.kube/
kubeconfig*
.vercel/
.netlify/
.firebase/
firebase-debug.log
*.tfstate
*.tfstate.*
*.tfvars


# -----------------------------------------------------------------------------
#  7. Dependencies
#  package-lock.json is intentionally NOT ignored. Committing it locks exact
#  dependency versions, which protects against supply-chain surprises.
# -----------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*
jspm_packages/
*.tgz


# -----------------------------------------------------------------------------
#  8. Build output and tool caches
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
release/
.vite/
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache
.prettiercache
.stylelintcache
coverage/
.nyc_output/
*.lcov


# -----------------------------------------------------------------------------
#  9. Logs and diagnostic reports
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# -----------------------------------------------------------------------------
#  10. Databases, dumps, and backups
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp


# -----------------------------------------------------------------------------
#  11. Editors and IDEs
#  Shared VS Code settings and extension recommendations ARE committed.
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.history/
.idea/
*.iml
*.swp
*.swo
*~
.claude/settings.local.json


# -----------------------------------------------------------------------------
#  12. Operating system files
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.Trash-*
.nfs*